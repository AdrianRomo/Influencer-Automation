# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/mvp
POSTGRES_DB=mvp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Celery / Redis ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── OpenAI (script generation + DALL-E images) ────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1792
IMAGE_QUALITY=standard

# ── ElevenLabs TTS ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_SPEED=1.0

# ── TTS / Duration tuning ─────────────────────────────────────────────────
TTS_TARGET_SECONDS=180
TTS_TOLERANCE_SECONDS=30
TTS_WAY_OFF_SECONDS=15
TTS_MAX_ATTEMPTS=2
TTS_DURATION_MIN_SECONDS=150
TTS_DURATION_MAX_SECONDS=210
TTS_OUTPUT_LANGUAGE=es-MX
TTS_CAL_ALPHA=0.3

# ── Storyboard ────────────────────────────────────────────────────────────
STORYBOARD_SCENES=8
RSS_LOOKBACK_DAYS=7

# ── Data directories (overridden by docker-compose) ───────────────────────
AUDIO_DIR=/data/audio
IMAGE_DIR=/data/images
VIDEO_DIR=/data/video

# ── Deployment ────────────────────────────────────────────────────────────
DOMAIN=example.com
API_KEY=

# Standalone Docker Compose ports (base docker-compose.yml)
API_PORT=8085
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8085
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Traefik override (docker-compose.traefik.yml)
TRAEFIK_DOCKER_NETWORK=proxy
TRAEFIK_API_HOST=influencer.example.com
TRAEFIK_FRONTEND_HOST=autonarrator.example.com
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERT_RESOLVER=cloudflare

# ── Auth / Security ───────────────────────────────────────────────────────
# SECRET_KEY is used to sign JWTs and encrypt stored API keys.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: set this to a unique random value in production.
SECRET_KEY=INSECURE-change-me-in-production
JWT_EXPIRE_MINUTES=10080

# ── Scheduled generation (Celery Beat) ───────────────────────────────────
ENABLE_SCHEDULED_GENERATION=false
BEAT_GENERATION_HOUR=6

# ── Animated video / scene-video provider ─────────────────────────────────
# Provider used for the background AI clips behind each scene.
#   static | black  → FFmpeg still-image clip (free, always-available fallback)
#   runway           → Runway Gen-4 image-to-video
#   seedance         → Seedance AI image-to-video
# Any provider that fails to init (missing key) silently falls back to static.
SCENE_VIDEO_PROVIDER=static
SCENE_VIDEO_TIMEOUT_SECONDS=600
SCENE_VIDEO_POLL_INTERVAL_SECONDS=10

# Style suffix appended to every clip prompt (camera/mood/quality direction).
VIDEO_STYLE=cinematic, realistic, smooth camera movement, soft lighting, high quality, social media ready

# ── Cost mode ──────────────────────────────────────────────────────────────
# low      → low-cost resolution, premium disabled (cheapest model everywhere)
# balanced → base resolution, premium only on VIDEO_PREMIUM_SCENES (if set)
# quality  → base resolution, premium enabled (defaults to the hook, scene 0)
VIDEO_COST_MODE=balanced
VIDEO_LOW_COST_RESOLUTION=720x1280

# Premium-scene strategy: route specific scenes to a higher-tier provider.
# Leave VIDEO_PREMIUM_PROVIDER blank to disable. Indices are 0-based.
VIDEO_PREMIUM_PROVIDER=
VIDEO_PREMIUM_SCENES=0

# Runway provider (required when SCENE_VIDEO_PROVIDER=runway)
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
RUNWAY_MODEL=gen4_turbo
RUNWAY_VERSION=2024-11-06
RUNWAY_RATIO=720:1280
RUNWAY_DURATION=5

# Seedance provider (required when SCENE_VIDEO_PROVIDER=seedance)
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://api.seedance.ai/v1
SEEDANCE_MODEL=seedance-1-lite
SEEDANCE_RESOLUTION=1080x1920
SEEDANCE_DURATION=5
